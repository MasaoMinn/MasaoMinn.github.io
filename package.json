{
  "name": "masaominn.github.io",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "metrics:types": "wrangler types workers/site-metrics/worker-configuration.d.ts --config workers/site-metrics/wrangler.jsonc",
    "metrics:migrate:local": "wrangler d1 migrations apply site-metrics-db --local --config workers/site-metrics/wrangler.jsonc",
    "metrics:migrate:remote": "wrangler d1 migrations apply site-metrics-db --remote --config workers/site-metrics/wrangler.jsonc",
    "metrics:dev": "wrangler dev --local --config workers/site-metrics/wrangler.jsonc",
    "metrics:check": "wrangler deploy --dry-run --config workers/site-metrics/wrangler.jsonc",
    "metrics:deploy": "wrangler deploy --config workers/site-metrics/wrangler.jsonc"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@types/lodash": "^4.17.25",
    "axios": "^1.20.0",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cursorlab": "^1.1.1",
    "gsap": "^3.15.0",
    "highlight.js": "^11.12.0",
    "i18next": "^26.4.2",
    "i18next-browser-languagedetector": "^8.2.1",
    "lodash": "^4.18.1",
    "lucide-react": "^1.44.0",
    "matter-js": "0.20.0",
    "motion": "^13.2.0",
    "next": "^16.3.4",
    "react": "^19.3.0",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.3.0",
    "react-furry-error": "^1.0.0",
    "react-i18next": "^17.0.13",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "styled-components": "^6.5.3",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260911.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/matter-js": "^0.20.2",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "wrangler": "4.131.1"
  }
}
